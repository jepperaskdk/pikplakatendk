---
const siteUrl = "https://pikplakaten.dk";
const pageUrl = `${siteUrl}/`;
const title = "Pikplakaten | Skal vi snart på kanotur?";
const description =
	"Pikplakaten samler årets kanotur med praktiske detaljer, stemning og en enkel plan for at komme ud i naturen.";
const ldJson = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Pikplakaten",
	url: siteUrl,
	inLanguage: "da-DK",
	description,
};
---

<!doctype html>
<html lang="da">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index,follow,max-image-preview:large" />
		<link rel="canonical" href={pageUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="da_DK" />
		<meta property="og:site_name" content="Pikplakaten" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;1,9..144,400&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
		<script type="application/ld+json" set:html={JSON.stringify(ldJson)}></script>
	</head>
	<body>
		<header>
			<span class="site-name">Pikplakaten</span>
		</header>
		<main>
			<div class="hero">
				<div class="hero-waves" aria-hidden="true">
					<svg viewBox="0 0 1440 120" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
						<path d="M0,60 C240,100 480,20 720,60 C960,100 1200,20 1440,60 L1440,120 L0,120 Z" fill="rgba(255,255,255,0.08)" />
						<path d="M0,80 C360,40 720,110 1080,70 C1260,50 1380,90 1440,80 L1440,120 L0,120 Z" fill="rgba(255,255,255,0.06)" />
					</svg>
				</div>
				<div class="hero-content">
					<div class="paddle-icon" aria-hidden="true">🛶</div>
					<h1>Skal vi snart<br />på kanotur?</h1>
					<p class="answer">Ja!</p>
					<p class="tagline">Padlerne er klar. Naturen venter. Hvornår stikker vi af?</p>
				</div>
			</div>
		</main>
		<footer>
			<p>Pikplakaten &copy; {new Date().getFullYear()}</p>
		</footer>
	</body>
</html>

<style>
	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		height: 100%;
	}

	body {
		min-height: 100%;
		display: flex;
		flex-direction: column;
		font-family: 'Inter', system-ui, sans-serif;
		background: #0b2a3a;
		color: #e8f4f8;
	}

	/* ── Header ── */
	header {
		padding: 1.25rem 2rem;
		display: flex;
		align-items: center;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(11, 42, 58, 0.85);
		backdrop-filter: blur(8px);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.site-name {
		font-family: 'Fraunces', Georgia, serif;
		font-size: 1.4rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: #7dd3fc;
	}

	/* ── Main / Hero ── */
	main {
		flex: 1;
	}

	.hero {
		position: relative;
		min-height: calc(100vh - 4rem);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background:
			radial-gradient(ellipse 80% 60% at 50% 110%, #0ea5e9 0%, transparent 70%),
			linear-gradient(175deg, #0b2a3a 0%, #0c3d54 40%, #0f4f6e 70%, #0e6b8f 100%);
	}

	.hero-waves {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 120px;
		pointer-events: none;
	}

	.hero-waves svg {
		width: 100%;
		height: 100%;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		text-align: center;
		padding: 3rem 1.5rem;
		max-width: 680px;
	}

	.paddle-icon {
		font-size: 4rem;
		margin-bottom: 1.5rem;
		display: block;
		filter: drop-shadow(0 4px 16px rgba(14, 165, 233, 0.5));
		animation: bob 3s ease-in-out infinite;
	}

	@keyframes bob {
		0%, 100% { transform: translateY(0); }
		50%       { transform: translateY(-10px); }
	}

	h1 {
		font-family: 'Fraunces', Georgia, serif;
		font-size: clamp(2.4rem, 6vw, 4.5rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: #f0f9ff;
		text-shadow: 0 2px 20px rgba(14, 165, 233, 0.35);
		margin-bottom: 1.5rem;
	}

	.answer {
		display: inline-block;
		font-family: 'Fraunces', Georgia, serif;
		font-size: clamp(3rem, 9vw, 6rem);
		font-weight: 700;
		font-style: italic;
		color: #38bdf8;
		text-shadow:
			0 0 40px rgba(56, 189, 248, 0.6),
			0 2px 8px rgba(0, 0, 0, 0.3);
		margin-bottom: 2rem;
		line-height: 1;
	}

	.tagline {
		font-size: 1.1rem;
		color: #bae6fd;
		font-weight: 400;
		line-height: 1.6;
		opacity: 0.85;
		max-width: 480px;
		margin: 0 auto;
	}

	/* ── Footer ── */
	footer {
		text-align: center;
		padding: 1.5rem;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.3);
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	/* ── Responsive ── */
	@media (max-width: 480px) {
		header {
			padding: 1rem 1.25rem;
		}

		.hero-content {
			padding: 2rem 1rem;
		}
	}
</style>
